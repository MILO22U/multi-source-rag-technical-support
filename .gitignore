# Environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Generated at runtime -- traces, dumps, caches.
# Kept out of git deliberately: logs/ grows to thousands of JSONL lines per eval run.
logs/*.jsonl
logs/chunks.jsonl
.cache/
*.index

# Eval outputs are regenerated by eval/ablations.py; the committed report in report/ is the artifact.
eval/results/

# Secrets -- API keys for the optional stages are read from the environment, never committed.
.env
*.key

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store

# VS Code: settings.json and launch.json ARE committed on purpose (reproducible setup for reviewers).
# Only local per-user state is ignored.
.vscode/*.log
.vscode/.ropeproject
